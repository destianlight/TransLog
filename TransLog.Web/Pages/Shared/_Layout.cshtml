@* Declared before <html>: variables inside <head> or <body> are not visible outside them. *@
@inject AreaBadges AreaBadges
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var badge = signedIn ? await AreaBadges.ForAsync(User) : null;
    var whatsApp = Contact.WhatsAppLink(Configuration);
    var siteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var pageTitle = ViewData["Title"] is string pt ? $"{pt} – TransLog" : "TransLog";
    // Menu highlight: the section of the current page (Home only on its exact address).
    var path = Context.Request.Path;
    string On(string prefix) => path.StartsWithSegments(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    string OnExact(string prefix) => string.Equals((path.Value ?? "").TrimEnd('/'), prefix, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var pageDescription = ViewData["Description"] as string
        ?? "Fleet slips, captured from one photo. Drivers photograph fuel slips, weighbridge tickets and odometers; AI reads them; you approve and report.";
}
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    @* Follow the phone's light or dark setting. Runs before the CSS loads so there is no flash. *@
    <script>
        (function () {
            var m = window.matchMedia('(prefers-color-scheme: dark)');
            function set() { document.documentElement.setAttribute('data-bs-theme', m.matches ? 'dark' : 'light'); }
            set();
            m.addEventListener('change', set);
        })();
    </script>
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    <meta name="theme-color" content="#0B1F3A" />

    @* Link previews (WhatsApp, Facebook, LinkedIn, X). The image must be an absolute URL. *@
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TransLog" />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@(siteUrl + Context.Request.Path)" />
    @* The ?v= changes with a new picture so WhatsApp and Facebook fetch it again instead of their cached copy. *@
    <meta property="og:image" content="@(siteUrl + "/resources/og-image.jpg?v=lion")" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TransLog: a truck with a roaring lion, and the TransLog logo" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="~/favicon.ico" sizes="48x48" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/resources/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/resources/lib-bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/resources/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="visually-hidden-focusable" href="#main">Skip to content</a>

    <header class="tl-header">
        @* Part 4b fix 2: few top items, the rest grouped in dropdowns; the menu folds into the ☰ button below 992 px
           (also a phone in "desktop site" mode). *@
        <nav class="navbar navbar-expand-lg" aria-label="Main">
            <div class="container">
                <a class="navbar-brand tl-brand" asp-area="" asp-page="/Index">
                    <svg class="tl-mark" aria-hidden="true"><use href="@(Icons.Sprite)#tl-mark"></use></svg>
                    <span>Trans<span class="tl-accent">Log</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Open menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1 tl-nav">
                        @if (signedIn)
                        {
                            if (User.IsInRole(Roles.SysAdmin))
                            {
                                <li class="nav-item"><a class="nav-link tl-navlink @OnExact("/sysadmin") @On("/sysadmin/companies")" asp-area="SysAdmin" asp-page="/Index">@Icons.Svg("buildings") Companies</a></li>
                                <li class="nav-item"><a class="nav-link tl-navlink @On("/sysadmin/admins")" asp-area="SysAdmin" asp-page="/Admins">@Icons.Svg("person-gear") TransLog admins</a></li>
                                <li class="nav-item"><a class="nav-link tl-navlink @On("/sysadmin/audit")" asp-area="SysAdmin" asp-page="/Audit">@Icons.Svg("journal-text") Audit log</a></li>
                                @* Part 5a1: AI pages grouped in one dropdown (5a2 adds AI providers, AI test, Platform settings). *@
                                <li class="nav-item dropdown">
                                    <a class="nav-link tl-navlink dropdown-toggle @On("/sysadmin/prompts")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@Icons.Svg("cpu") AI</a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item tl-navlink @On("/sysadmin/prompts")" asp-area="SysAdmin" asp-page="/Prompts/Index">@Icons.Svg("chat-square-text") AI prompts</a></li>
                                    </ul>
                                </li>
                            }
                            else if (User.IsInRole(Roles.Driver))
                            {
                                <li class="nav-item"><a class="nav-link tl-navlink @OnExact("/driver")" asp-area="Driver" asp-page="/Index">@Icons.Svg("house") Home</a></li>
                                <li class="nav-item"><a class="nav-link tl-navlink @On("/driver/capture")" asp-area="Driver" asp-page="/Capture">@Icons.Svg("camera") Photograph</a></li>
                                <li class="nav-item"><a class="nav-link tl-navlink @On("/driver/slips")" asp-area="Driver" asp-page="/Slips">@Icons.Svg("images") My slips</a></li>
                                <li class="nav-item"><a class="nav-link tl-navlink @On("/driver/myvehicle")" asp-area="Driver" asp-page="/MyVehicle">@Icons.Svg("truck-front") My vehicle</a></li>
                            }
                            else if (User.GetCompanyId() is not null)
                            {
                                var fleetAdmin = User.IsInRole(Roles.Owner) || User.IsInRole(Roles.Admin);
                                var canCapture = fleetAdmin || User.IsInRole(Roles.Capturer);
                                var fleetOn = On("/company/drivers") + On("/company/vehicles") + On("/company/links");
                                var companyOn = On("/company/users") + On("/company/settings") + On("/company/activity");
                                <li class="nav-item"><a class="nav-link tl-navlink @OnExact("/company")" asp-area="Company" asp-page="/Index">@Icons.Svg("house") Home</a></li>
                                if (canCapture)
                                {
                                    <li class="nav-item"><a class="nav-link tl-navlink @On("/company/capture")" asp-area="Company" asp-page="/Capture">@Icons.Svg("cloud-arrow-up") Capture</a></li>
                                }
                                <li class="nav-item"><a class="nav-link tl-navlink @On("/company/captures")" asp-area="Company" asp-page="/Captures/Index">@Icons.Svg("images") Captures</a></li>
                                if (fleetAdmin)
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link tl-navlink dropdown-toggle @(fleetOn.Length > 0 ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@Icons.Svg("truck") Fleet</a>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item tl-navlink @On("/company/drivers")" asp-area="Company" asp-page="/Drivers/Index">@Icons.Svg("person-vcard") Drivers</a></li>
                                            <li><a class="dropdown-item tl-navlink @On("/company/vehicles")" asp-area="Company" asp-page="/Vehicles/Index">@Icons.Svg("truck") Vehicles</a></li>
                                            <li><a class="dropdown-item tl-navlink @On("/company/links")" asp-area="Company" asp-page="/Links/Index">@Icons.Svg("clock-history") Link history</a></li>
                                        </ul>
                                    </li>
                                }
                                if (User.IsInRole(Roles.Owner))
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link tl-navlink dropdown-toggle @(companyOn.Length > 0 ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@Icons.Svg("buildings") Company</a>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item tl-navlink @On("/company/users")" asp-area="Company" asp-page="/Users/Index">@Icons.Svg("people") Users</a></li>
                                            <li><a class="dropdown-item tl-navlink @On("/company/settings")" asp-area="Company" asp-page="/Settings">@Icons.Svg("gear") Settings</a></li>
                                            <li><a class="dropdown-item tl-navlink @On("/company/activity")" asp-area="Company" asp-page="/Activity">@Icons.Svg("list-check") Activity</a></li>
                                        </ul>
                                    </li>
                                }
                            }
                            <li class="nav-item dropdown">
                                <a class="nav-link tl-navlink dropdown-toggle fw-semibold @On("/account")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Icons.Svg("person-circle") <span class="tl-navname">@User.GetFullName()</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item tl-navlink" asp-area="" asp-page="/Account/Index">@Icons.Svg("person-circle") My account</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-area="" asp-page="/Logout">
                                            <button type="submit" class="dropdown-item tl-navlink">@Icons.Svg("box-arrow-right") Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" href="/#how">How it works</a></li>
                            <li class="nav-item"><a class="nav-link" href="/#types">What you can capture</a></li>
                            <li class="nav-item"><a class="nav-link" href="/#features">Features</a></li>
                            <li class="nav-item"><a class="nav-link fw-semibold" asp-area="" asp-page="/Login">Log in</a></li>
                            <li class="nav-item"><a class="btn btn-tl ms-lg-2" href="@whatsApp" target="_blank" rel="noopener">Register on WhatsApp</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
        @if (badge is not null)
        {
            <div class="tl-areabar @badge.Css" data-area="@badge.Area">
                <div class="container d-flex align-items-center gap-2 py-2">
                    <span class="tl-areabar-icon">@Icons.Svg(badge.Icon)</span>
                    <span class="fw-semibold text-truncate">@badge.Title</span>
                    <span class="small opacity-75 text-truncate">@badge.Subtitle</span>
                </div>
            </div>
        }
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="tl-footer border-top">
        <div class="container d-flex flex-wrap justify-content-between gap-3 py-4 small text-body-secondary">
            <span>&copy; @AppCulture.ToSast(DateTime.UtcNow).Year TransLog</span>
            <div class="d-flex flex-wrap gap-4">
                <a href="#">Privacy (POPIA)</a>
                <a href="#">Terms</a>
                <a href="@whatsApp" target="_blank" rel="noopener">WhatsApp @Contact.WhatsAppDisplay(Configuration)</a>
            </div>
        </div>
    </footer>

    <script src="~/resources/lib-bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/resources/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
