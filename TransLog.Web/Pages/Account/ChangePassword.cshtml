@page
@model TransLog.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<section class="tl-section">
    <div class="container" style="max-width: 440px">
        <h1 class="tl-h2 mb-4">Change password</h1>

        <form method="post" class="tl-card">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label">Current password</label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">New password (at least 6 characters)</label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">New password again</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-tl w-100">Change password</button>
        </form>

        <p class="mt-3"><a asp-page="/Account/Index">Back to my account</a></p>
    </div>
</section>
