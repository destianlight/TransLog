@page "{id:int}"
@model TransLog.Web.Areas.CompanyArea.Pages.Vehicles.EditModel
@{
    ViewData["Catalogue"] = Model.Catalogue; // read by _VehicleFields
    ViewData["Title"] = Model.Registration;
}

<section class="tl-section">
    <div class="container" style="max-width: 720px">
        <p class="mb-2"><a asp-page="Index">&larr; Vehicles</a></p>
        <h1 class="tl-h2 mb-4">@Model.Registration</h1>

        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <div class="tl-card mb-4">
            <h2 class="h5">Driver</h2>
            <p class="mb-1">@(Model.DriverName is null ? "No driver linked." : $"Driven by {Model.DriverName}.")</p>
            <p class="small mb-0"><a asp-page="/Links/Index" asp-route-vehicleId="@Model.Id">Link history</a>. Link a driver from the driver's page.</p>
        </div>

        <form method="post" class="tl-card mb-4">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>
            <partial name="_VehicleFields" for="Form" />
            <div class="form-check form-switch mt-4">
                <input asp-for="Form.IsActive" class="form-check-input" role="switch" />
                <label asp-for="Form.IsActive" class="form-check-label">Vehicle is in use (switch off to hide it from pick lists; its history stays)</label>
            </div>
            <button type="submit" class="btn btn-tl mt-3">Save</button>
        </form>

        <div class="tl-card">
            <h2 class="h5">Names used on slips</h2>
            <p class="small text-body-secondary">
                Add every way a slip prints this vehicle, such as an old plate, a common misspelling or a pump name.
                TransLog uses them to find the right vehicle.
            </p>

            @if (Model.Aliases.Count == 0)
            {
                <p class="small mb-3">None yet.</p>
            }
            else
            {
                <ul class="list-group mb-3">
                    @foreach (var a in Model.Aliases)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@a.Alias</span>
                            <form method="post" asp-page-handler="RemoveAlias" asp-route-id="@Model.Id" asp-route-aliasId="@a.Id">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Remove</button>
                            </form>
                        </li>
                    }
                </ul>
            }

            <form method="post" asp-page-handler="AddAlias" asp-route-id="@Model.Id" class="d-flex gap-2">
                <input name="newAlias" class="form-control text-uppercase" maxlength="30" placeholder="For example TFNPUMP1" autocomplete="off" autocapitalize="characters" aria-label="New name" />
                <button type="submit" class="btn btn-tl">Add</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/resources/page-vehicle-form.js" asp-append-version="true"></script>
}
