@model VehicleForm
@{
    var names = ViewData["VehicleNames"] as List<VehicleName> ?? [];
    var questions = ViewData["NameQuestions"] as List<NameSuggestion> ?? [];
    // Every known make, model and variant for the suggestion lists (page-vehicle-form.js filters them by make and model).
    var namesJson = System.Text.Json.JsonSerializer.Serialize(
        names.Select(n => new { a = n.Make, b = n.Model, c = n.Variant, u = n.Uses }));
    var typeItems = VehicleOptions.Types.Select(t => new SelectListItem(t, t)).ToList();
    var fuelItems = VehicleOptions.FuelTypes.Select(t => new SelectListItem(t, t)).ToList();
}
<div class="row g-3">
    <div class="col-sm-6">
        <label asp-for="RegistrationNo" class="form-label">Registration number</label>
        <input asp-for="RegistrationNo" class="form-control text-uppercase" autocomplete="off" autocapitalize="characters" />
        <div class="form-text">Spaces and dashes are ignored: LLT 587 NW and LLT587NW are the same.</div>
        <span asp-validation-for="RegistrationNo" class="text-danger small"></span>
    </div>
    <div class="col-sm-6">
        <label asp-for="FleetNo" class="form-label">Fleet number (optional)</label>
        <input asp-for="FleetNo" class="form-control" />
    </div>
    @if (questions.Count > 0)
    {
        <div class="col-12">
            <div class="alert alert-warning mb-0">
                @foreach (var q in questions)
                {
                    <p class="mb-1">@q.Field: did you mean <strong>@q.Suggestion</strong>? You typed <em>@q.Typed</em>.</p>
                }
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="submit" name="Form.AcceptSuggestions" value="true" class="btn btn-tl btn-sm">Use @(questions.Count == 1 ? "that" : "those")</button>
                    <button type="submit" name="Form.KeepTyped" value="true" class="btn btn-outline-secondary btn-sm">Keep what I typed</button>
                </div>
            </div>
        </div>
    }
    <div class="col-sm-4">
        <label asp-for="Make" class="form-label">Make</label>
        <input asp-for="Make" class="form-control" list="tl-makes" autocomplete="off" placeholder="Mercedes-Benz" data-tl-make />
        <datalist id="tl-makes"></datalist>
        <span asp-validation-for="Make" class="text-danger small"></span>
    </div>
    <div class="col-sm-4">
        <label asp-for="Model" class="form-label">Model</label>
        <input asp-for="Model" class="form-control" list="tl-models" autocomplete="off" placeholder="Actros" data-tl-model />
        <datalist id="tl-models"></datalist>
        <span asp-validation-for="Model" class="text-danger small"></span>
    </div>
    <div class="col-sm-4">
        <label asp-for="Variant" class="form-label">Variant (optional)</label>
        <input asp-for="Variant" class="form-control" list="tl-variants" autocomplete="off" placeholder="2645 LS" data-tl-variant />
        <datalist id="tl-variants"></datalist>
        <span asp-validation-for="Variant" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <div class="form-text mt-0">Type freely: the lists suggest names already used in TransLog. Small spelling differences are matched up when you save.</div>
        <script type="application/json" id="tl-vehicle-names">@Html.Raw(namesJson)</script>
    </div>
    <div class="col-sm-4">
        <label asp-for="Year" class="form-label">Year</label>
        <input asp-for="Year" class="form-control" type="number" inputmode="numeric" />
        <span asp-validation-for="Year" class="text-danger small"></span>
    </div>
    <div class="col-sm-4">
        <label asp-for="VehicleType" class="form-label">Type</label>
        <select asp-for="VehicleType" asp-items="typeItems" class="form-select">
            <option value="">Not set</option>
        </select>
    </div>
    <div class="col-sm-4">
        <label asp-for="FuelType" class="form-label">Fuel</label>
        <select asp-for="FuelType" asp-items="fuelItems" class="form-select">
            <option value="">Not set</option>
        </select>
    </div>
    <div class="col-sm-6">
        <label asp-for="TankCapacity" class="form-label">Tank size (litres)</label>
        <input asp-for="TankCapacity" class="form-control" type="number" step="0.1" inputmode="decimal" />
        <span asp-validation-for="TankCapacity" class="text-danger small"></span>
    </div>
    <div class="col-sm-6">
        <label asp-for="CurrentOdometer" class="form-label">Odometer now (km)</label>
        <input asp-for="CurrentOdometer" class="form-control" type="number" inputmode="numeric" />
        <span asp-validation-for="CurrentOdometer" class="text-danger small"></span>
    </div>
    <div class="col-sm-6">
        <label asp-for="LicenceDiscExpiry" class="form-label">Licence disc expires</label>
        <input asp-for="LicenceDiscExpiry" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
    </div>
    <div class="col-sm-6">
        <label asp-for="RoadworthyExpiry" class="form-label">Roadworthy expires</label>
        <input asp-for="RoadworthyExpiry" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
    </div>
</div>
