@page
@model TransLog.Web.Areas.CompanyArea.Pages.Captures.IndexModel
@using TransLog.Web.Captures
@{
    ViewData["Title"] = "Captures";
    var canCapture = User.IsInRole(Roles.Owner) || User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Capturer);
}

<section class="tl-section pt-4">
    <div class="container" style="max-width: 960px">
        <div class="d-flex align-items-center gap-2 mb-3">
            <h1 class="tl-h2 mb-0 me-auto">Captures</h1>
            @if (canCapture)
            {
                <a class="btn btn-tl" asp-page="/Capture">@Icons.Svg("cloud-arrow-up") Capture</a>
            }
        </div>

        <div class="tl-filters mb-2">
            @foreach (var show in new[] { CaptureShow.All, CaptureShow.Busy, CaptureShow.Done })
            {
                <a class="btn btn-sm @(Model.Show == show ? "btn-tl" : "btn-outline-secondary")" asp-page="/Captures/Index" asp-all-route-data="Model.With(show)">@show</a>
            }
        </div>

        <form method="get" class="row g-2 align-items-end mb-3">
            @if (Model.Show != CaptureShow.All)
            {
                <input type="hidden" name="show" value="@Model.Show.ToString().ToLowerInvariant()" />
            }
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="from">From</label>
                <input type="date" id="from" name="from" class="form-control form-control-sm"
                       value="@(Model.From is DateOnly f ? TransLog.Web.Areas.CompanyArea.Pages.Captures.IndexModel.Day(f) : "")" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="to">To</label>
                <input type="date" id="to" name="to" class="form-control form-control-sm"
                       value="@(Model.To is DateOnly t ? TransLog.Web.Areas.CompanyArea.Pages.Captures.IndexModel.Day(t) : "")" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="driverId">Driver</label>
                <select id="driverId" name="driverId" class="form-select form-select-sm" asp-items="Model.DriverChoices">
                    <option value="">All drivers</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="vehicleId">Vehicle</label>
                <select id="vehicleId" name="vehicleId" class="form-select form-select-sm" asp-items="Model.VehicleChoices">
                    <option value="">All vehicles</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-tl flex-grow-1">Filter</button>
                @if (Model.Filtered)
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Captures/Index" aria-label="Clear filters">@Icons.Svg("x-lg")</a>
                }
            </div>
        </form>

        @if (Model.Rows.Count == 0)
        {
            <div class="tl-card p-3 text-body-secondary">@(Model.Filtered || Model.PageNo > 1 ? "No captures for this choice." : "No captures yet.")</div>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var r in Model.Rows)
                {
                    <div class="tl-card p-2 d-flex gap-3 align-items-center">
                        @if (r.ImageId is int imageId)
                        {
                            <a href="/files/capture/@imageId" target="_blank" class="flex-shrink-0">
                                <img src="/files/capture/@imageId/thumb" alt="Slip photo" width="64" height="85" loading="lazy"
                                     class="rounded object-fit-cover bg-body-tertiary" />
                            </a>
                        }
                        <div class="small flex-grow-1 min-w-0">
                            <div class="fw-semibold">@AppCulture.ToSast(r.CapturedAt).ToString("yyyy-MM-dd HH:mm")</div>
                            <div class="text-truncate">@(r.Driver ?? "No driver") · @(r.Vehicle ?? "No vehicle")</div>
                            <div class="text-body-secondary text-truncate">
                                @if (r.Source == ImageSource.Office)
                                {
                                    <span>@(r.By.Length > 0 ? "Office upload by " + r.By : "Office upload")</span>
                                }
                                else
                                {
                                    <span>@(r.Source == ImageSource.Gallery ? "Phone (from gallery)" : "Phone")</span>
                                    if (!r.HasLocation) { <span> · no location</span> }
                                }
                            </div>
                            <partial name="_CaptureProgress" model="new CaptureProgress(r.CaptureId, r.Status)" />
                        </div>
                    </div>
                }
            </div>

            @if (Model.PageNo > 1 || Model.HasNext)
            {
                <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Pages">
                    @if (Model.PageNo > 1)
                    {
                        <a class="btn btn-outline-secondary" asp-page="/Captures/Index" asp-all-route-data="Model.With(page: Model.PageNo - 1)">&larr; Newer</a>
                    }
                    else
                    {
                        <span></span>
                    }
                    <span class="small text-body-secondary">Page @Model.PageNo</span>
                    @if (Model.HasNext)
                    {
                        <a class="btn btn-outline-secondary" asp-page="/Captures/Index" asp-all-route-data="Model.With(page: Model.PageNo + 1)">Older &rarr;</a>
                    }
                    else
                    {
                        <span></span>
                    }
                </nav>
            }
        }
    </div>
</section>
