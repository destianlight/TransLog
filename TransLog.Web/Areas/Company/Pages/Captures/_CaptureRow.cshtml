@model TransLog.Web.Areas.CompanyArea.Pages.Captures.IndexModel.Row
@using TransLog.Web.Captures
@using TransLog.Web.Areas.CompanyArea.Pages.Captures
@* One slip on the Captures list (Part 5b: its own partial, fetched again by page-capture-live.js on a live message). *@
@{
    var r = Model;
    var css = "tl-card p-2 d-flex gap-3 align-items-center" + (r.Reading ? " tl-scan" : "");
}
<div class="@css" data-row="@r.CaptureId" data-status="@((int)r.Status)">
    @if (r.ImageId is int imageId)
    {
        <a href="/files/capture/@imageId" target="_blank" class="tl-thumb flex-shrink-0">
            <img src="/files/capture/@imageId/thumb" alt="Slip photo" width="64" height="85" loading="lazy"
                 class="rounded object-fit-cover bg-body-tertiary" />
        </a>
    }
    <div class="small flex-grow-1 min-w-0">
        @if (r.EventDate is DateOnly ed)
        {
            <div class="fw-semibold">@("Slip " + IndexModel.Day(ed))</div>
            <div class="tl-photo-date text-body-secondary">@("Photo " + AppCulture.ToSast(r.CapturedAt).ToString("yyyy-MM-dd HH:mm"))</div>
        }
        else
        {
            <div class="fw-semibold">@AppCulture.ToSast(r.CapturedAt).ToString("yyyy-MM-dd HH:mm")</div>
        }
        <div class="text-truncate">@(r.Driver ?? "No driver") · @(r.Vehicle ?? "No vehicle")</div>
        <div class="text-body-secondary text-truncate">
            @if (r.Source == ImageSource.Office)
            {
                <span>@(r.By.Length > 0 ? "Office upload by " + r.By : "Office upload")</span>
            }
            else
            {
                <span>@(r.Source == ImageSource.Gallery ? "Phone (from gallery)" : "Phone")</span>
                if (!r.HasLocation) { <span> · no location</span> }
            }
        </div>
        @if (r.TypeName is not null || r.EventDate is not null)
        {
            <div data-read="@r.CaptureId"><strong>@(r.TypeName ?? "Type not sure")</strong></div>
        }
        @if (r.Note is not null)
        {
            <div class="text-warning-emphasis text-truncate">@Icons.Svg("exclamation-triangle") @r.Note</div>
        }
        @if (r.Values.Count > 0)
        {
            <details class="mt-1">
                <summary class="text-body-secondary">What the AI read</summary>
                <dl class="row mb-0 mt-1">
                    @foreach (var (label, value) in r.Values)
                    {
                        <dt class="col-5 fw-normal text-body-secondary">@label</dt>
                        <dd class="col-7 mb-0 font-monospace text-break">@value</dd>
                    }
                </dl>
            </details>
        }
        <partial name="_CaptureProgress" model="new CaptureProgress(r.CaptureId, r.Status, r.Reading)" />
    </div>
</div>
