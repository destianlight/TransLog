@page
@model IndexModel
@{
    ViewData["Title"] = Model.CompanyName;
}

<section class="tl-section">
    <div class="container">
        <p class="tl-eyebrow mb-1">@Model.CompanyName</p>
        <h1 class="tl-h2 mb-4">Welcome, @User.GetFullName()</h1>

        <div class="row g-3">
            @if (Model.IsOwner)
            {
                <div class="col-md-4">
                    <a class="tl-card tl-card-link d-block h-100" asp-page="/Users/Index">
                        <svg class="tl-icon" aria-hidden="true"><use href="/resources/icons.svg#person"></use></svg>
                        <h2 class="h6 mt-2">Users</h2>
                        <p class="small text-body-secondary mb-0">Add your team, set their roles, switch them on or off.</p>
                    </a>
                </div>
                <div class="col-md-4">
                    <a class="tl-card tl-card-link d-block h-100" asp-page="/Settings">
                        <svg class="tl-icon" aria-hidden="true"><use href="/resources/icons.svg#speedometer2"></use></svg>
                        <h2 class="h6 mt-2">Company settings</h2>
                        <p class="small text-body-secondary mb-0">Contact details and who may link drivers to vehicles.</p>
                    </a>
                </div>
                <div class="col-md-4">
                    <a class="tl-card tl-card-link d-block h-100" asp-page="/Activity">
                        <svg class="tl-icon" aria-hidden="true"><use href="/resources/icons.svg#receipt"></use></svg>
                        <h2 class="h6 mt-2">Activity</h2>
                        <p class="small text-body-secondary mb-0">Who changed what in your company.</p>
                    </a>
                </div>
            }
            @if (Model.IsFleetAdmin)
            {
                <div class="col-md-4">
                    <a class="tl-card tl-card-link d-block h-100" asp-page="/Drivers/Index">
                        <svg class="tl-icon" aria-hidden="true"><use href="/resources/icons.svg#person"></use></svg>
                        <h2 class="h6 mt-2">Drivers</h2>
                        <p class="small text-body-secondary mb-0">Your drivers, licences and permit expiry dates.</p>
                    </a>
                </div>
                <div class="col-md-4">
                    <a class="tl-card tl-card-link d-block h-100" asp-page="/Vehicles/Index">
                        <svg class="tl-icon" aria-hidden="true"><use href="/resources/icons.svg#truck"></use></svg>
                        <h2 class="h6 mt-2">Vehicles</h2>
                        <p class="small text-body-secondary mb-0">Registrations, names used on slips, disc and roadworthy dates.</p>
                    </a>
                </div>
            }
            else
            {
                <div class="col-md-4">
                    <a class="tl-card tl-card-link d-block h-100" asp-page="/MyVehicle">
                        <svg class="tl-icon" aria-hidden="true"><use href="/resources/icons.svg#truck"></use></svg>
                        <h2 class="h6 mt-2">My vehicle</h2>
                        <p class="small text-body-secondary mb-0">See or pick the vehicle you drive.</p>
                    </a>
                </div>
            }
            <div class="col-md-4">
                <div class="tl-card h-100">
                    <svg class="tl-icon" aria-hidden="true"><use href="/resources/icons.svg#camera"></use></svg>
                    <h2 class="h6 mt-2">Slips</h2>
                    <p class="small text-body-secondary mb-0">Photos read by AI, ready for you to approve. Coming in Parts 4 to 6.</p>
                </div>
            </div>
        </div>
    </div>
</section>
