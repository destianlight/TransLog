@model TransLog.Web.Areas.DriverArea.Pages.SlipsModel.SlipRow
@using TransLog.Web.Captures
@* One slip on My slips (Part 5b: its own partial, fetched again by page-capture-live.js on a live message).
   Part 5b2: the photo and the date open the slip page. *@
@{
    var s = Model;
    var css = "tl-card p-2 d-flex gap-3 align-items-center" + (s.Reading ? " tl-scan" : "");
    var line = (s.TypeName is null ? "" : s.TypeName + " · ") + (s.Vehicle ?? "No vehicle");
}
<div class="@css" data-row="@s.CaptureId" data-status="@((int)s.Status)">
    @if (s.ImageId is int imageId)
    {
        <a href="/driver/slips/@s.CaptureId" class="tl-thumb flex-shrink-0" aria-label="Open slip">
            <img src="/files/capture/@imageId/thumb" alt="Slip photo" width="64" height="85" loading="lazy"
                 class="rounded object-fit-cover bg-body-tertiary" />
        </a>
    }
    <div class="small flex-grow-1 min-w-0">
        @if (s.EventDate is DateOnly ed)
        {
            <a class="fw-semibold d-block text-body text-decoration-none" href="/driver/slips/@s.CaptureId">@("Slip " + ed.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))</a>
            <div class="tl-photo-date text-body-secondary">@("Photo " + AppCulture.ToSast(s.CapturedAt).ToString("yyyy-MM-dd HH:mm"))</div>
        }
        else
        {
            <a class="fw-semibold d-block text-body text-decoration-none" href="/driver/slips/@s.CaptureId">@AppCulture.ToSast(s.CapturedAt).ToString("yyyy-MM-dd HH:mm")</a>
        }
        <div class="text-body-secondary text-truncate">
            @line
            @if (s.Source == ImageSource.Gallery) { <span> · from gallery</span> }
            @if (s.Source == ImageSource.Office) { <span> · added by the office</span> }
            else if (!s.HasLocation) { <span> · no location</span> }
        </div>
        <partial name="_CaptureProgress" model="new CaptureProgress(s.CaptureId, s.Status, s.Reading)" />
    </div>
</div>
