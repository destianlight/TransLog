@page
@model IndexModel
@{
    ViewData["Title"] = "Driver";
}

@Html.AntiForgeryToken()
<section class="tl-section pt-4">
    <div class="container" style="max-width: 560px">
        <div class="d-flex align-items-center gap-3 mb-4">
            @if (Model.HasDriver)
            {
                <a class="tl-avatar-link" asp-page="/Photo" aria-label="My photo">
                    @TransLog.Web.Fleet.DriverPhotos.Avatar(Model.DriverId, Model.PhotoPath, User.GetFullName(), "tl-avatar-lg")
                    <span class="tl-avatar-edit">@Icons.Svg("camera-fill")</span>
                </a>
            }
            <div class="min-w-0">
                <p class="tl-eyebrow mb-1">@Model.CompanyName</p>
                <h1 class="tl-h2 mb-0">Hi, @User.GetFullName()</h1>
                @if (Model.HasDriver && Model.PhotoPath is null)
                {
                    <a class="small" asp-page="/Photo">Add your photo</a>
                }
            </div>
        </div>

        @if (!Model.HasDriver)
        {
            <div class="tl-card mb-3">
                <p class="mb-0">Your login is not linked to a driver. Ask your company to check your driver details.</p>
            </div>
        }

        <div class="d-grid gap-3">
            <a class="tl-card tl-card-link tl-bigbtn" asp-page="/Capture">
                @Icons.Svg("camera")
                <span>Photograph a slip<span class="d-block small fw-normal text-body-secondary">Fuel, weighbridge, odometer or receipt</span></span>
            </a>
            <a class="tl-card tl-card-link tl-bigbtn" asp-page="/MyVehicle">
                @Icons.Svg("truck-front")
                <span>
                    My vehicle
                    <span class="d-block small fw-normal text-body-secondary">
                        @(Model.Current is { } c ? $"Driving {c.Vehicle}" : "No vehicle yet")
                    </span>
                </span>
            </a>
            <a class="tl-card tl-card-link tl-bigbtn" asp-page="/Slips">
                @Icons.Svg("images")
                <span>My slips<span class="d-block small fw-normal text-body-secondary" id="waitingText">Photos you sent</span></span>
            </a>
        </div>
    </div>
</section>

@section Scripts {
    @* Photos still on the phone are sent as soon as the driver opens the app. *@
    <script src="~/resources/page-capture-queue.js" asp-append-version="true"></script>
    <script>
        (function () {
            var text = document.getElementById('waitingText');
            window.addEventListener('tlqueue', function (e) {
                var n = e.detail.count;
                text.textContent = n === 0 ? 'Photos you sent' : (n === 1 ? '1 photo waiting to send' : n + ' photos waiting to send');
                text.classList.toggle('text-warning-emphasis', n > 0);
            });
            TLQueue.sendAll();
        })();
    </script>
}
