@page
@model SlipsModel
@using TransLog.Web.Captures
@{
    ViewData["Title"] = "My slips";
}

<section class="tl-section pt-4">
    <div class="container" style="max-width: 720px">
        @Html.AntiForgeryToken()
        <div class="d-flex align-items-center gap-2 mb-3">
            <h1 class="tl-h2 mb-0 me-auto">My slips</h1>
            <a class="btn btn-tl" asp-page="/Capture">@Icons.Svg("camera") Photograph</a>
        </div>

        @* Filled by the script below from the photos kept on this phone. *@
        <div id="waiting" class="tl-card mb-3 p-3" hidden>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="fw-semibold me-auto">@Icons.Svg("cloud-arrow-up") Waiting to send on this phone</span>
                <button type="button" class="btn btn-sm btn-tl" id="sendNow">Send now</button>
            </div>
            <div id="waitingList" class="d-flex flex-column gap-2"></div>
        </div>

        @* Filters: All / Busy / Done and one day. *@
        <form method="get" class="tl-filters mb-3" id="slipFilters">
            @foreach (var show in new[] { CaptureShow.All, CaptureShow.Busy, CaptureShow.Done })
            {
                <a class="btn btn-sm @(Model.Show == show ? "btn-tl" : "btn-outline-secondary")" asp-page="/Slips" asp-all-route-data="Model.With(show)">@show</a>
            }
            @if (Model.Show != CaptureShow.All)
            {
                <input type="hidden" name="show" value="@Model.Show.ToString().ToLowerInvariant()" />
            }
            <input type="date" name="day" class="form-control form-control-sm w-auto ms-auto" aria-label="Day"
                   value="@(Model.Day?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" />
            @if (Model.Day is not null)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Slips" asp-route-show="@(Model.Show == CaptureShow.All ? null : Model.Show.ToString().ToLowerInvariant())" aria-label="All days">@Icons.Svg("x-lg")</a>
            }
        </form>

        @if (Model.Slips.Count == 0)
        {
            <div class="tl-card p-3 text-body-secondary">@(Model.Filtered ? "No slips for this choice." : "No slips sent yet.")</div>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var s in Model.Slips)
                {
                    <div class="tl-card p-2 d-flex gap-3 align-items-center">
                        @if (s.ImageId is int imageId)
                        {
                            <a href="/files/capture/@imageId" target="_blank" class="flex-shrink-0">
                                <img src="/files/capture/@imageId/thumb" alt="Slip photo" width="64" height="85" loading="lazy"
                                     class="rounded object-fit-cover bg-body-tertiary" />
                            </a>
                        }
                        <div class="small flex-grow-1 min-w-0">
                            <div class="fw-semibold">@AppCulture.ToSast(s.CapturedAt).ToString("yyyy-MM-dd HH:mm")</div>
                            <div class="text-body-secondary text-truncate">
                                @(s.Vehicle ?? "No vehicle")
                                @if (s.Source == ImageSource.Gallery) { <span> · from gallery</span> }
                                @if (s.Source == ImageSource.Office) { <span> · added by the office</span> }
                                else if (!s.HasLocation) { <span> · no location</span> }
                            </div>
                            <partial name="_CaptureProgress" model="new CaptureProgress(s.CaptureId, s.Status)" />
                        </div>
                    </div>
                }
            </div>
            @if (Model.HasMore)
            {
                <div class="text-center mt-3">
                    <a class="btn btn-outline-secondary" asp-page="/Slips" asp-all-route-data="Model.With(take: Model.Take + SlipsModel.PageSize)">Show @SlipsModel.PageSize more</a>
                </div>
            }
        }
    </div>
</section>

@section Scripts {
    <script src="~/resources/page-capture-queue.js" asp-append-version="true"></script>
    <script>
        (function () {
            var box = document.getElementById('waiting'), list = document.getElementById('waitingList'), urls = [];
            function fmt(ms) {
                var d = new Date(ms), p = function (n) { return String(n).padStart(2, '0'); };
                return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
            }
            function draw(items) {
                urls.forEach(URL.revokeObjectURL); urls = [];
                list.textContent = '';
                box.hidden = items.length === 0;
                items.forEach(function (item) {
                    var row = document.createElement('div');
                    row.className = 'd-flex gap-3 align-items-center small';
                    var img = document.createElement('img');
                    var url = URL.createObjectURL(item.thumb || item.photo); urls.push(url);
                    img.src = url; img.width = 48; img.height = 64; img.alt = '';
                    img.className = 'rounded object-fit-cover flex-shrink-0';
                    var text = document.createElement('div');
                    text.className = 'flex-grow-1';
                    text.innerHTML = '<div class="fw-semibold"></div><div class="text-body-secondary"></div>';
                    text.firstChild.textContent = fmt(item.capturedAt);
                    text.lastChild.textContent = item.failed ? 'Not accepted: ' + item.failed : 'Waiting for signal';
                    if (item.failed) text.lastChild.className = 'text-danger';
                    row.appendChild(img); row.appendChild(text);
                    if (item.failed) {
                        var del = document.createElement('button');
                        del.type = 'button'; del.className = 'btn btn-sm btn-outline-danger'; del.textContent = 'Remove';
                        del.onclick = function () { TLQueue.remove(item.key); };
                        row.appendChild(del);
                    }
                    list.appendChild(row);
                });
            }
            var filters = document.getElementById('slipFilters');
            filters.elements.day.addEventListener('change', function () { filters.submit(); });
            var sentSome = false;
            window.addEventListener('tlqueue', function (e) { draw(e.detail.items); });
            document.getElementById('sendNow').onclick = function () {
                TLQueue.sendAll({ onSent: function () { sentSome = true; } }).then(function () { if (sentSome) location.reload(); });
            };
            TLQueue.sendAll({ onSent: function () { sentSome = true; } }).then(function () { if (sentSome) location.reload(); });
        })();
    </script>
}
