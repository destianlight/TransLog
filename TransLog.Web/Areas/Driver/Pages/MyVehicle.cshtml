@page
@model TransLog.Web.Areas.DriverArea.Pages.MyVehicleModel
@{
    ViewData["Title"] = "My vehicle";
}

<section class="tl-section pt-4">
    <div class="container" style="max-width: 720px">
        <h1 class="tl-h2 mb-4">My vehicle</h1>

        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        @if (!Model.HasDriver)
        {
            <div class="tl-card">
                <p class="mb-0">Your login is not linked to a driver. Ask your company to check your driver details.</p>
            </div>
        }
        else
        {
            <div class="tl-card">
                @if (Model.TakeOver is { } t)
                {
                    <div class="alert alert-warning">
                        <p class="mb-2">
                            <strong>@t.Vehicle</strong> is with <strong>@t.OtherDriver</strong>
                            since @AppCulture.ToSast(t.Since).ToString("yyyy-MM-dd HH:mm"). Take it over?
                        </p>
                        <form method="post" asp-page-handler="Link" class="d-flex flex-wrap gap-2">
                            <input type="hidden" name="vehicleId" value="@t.VehicleId" />
                            <input type="hidden" name="confirm" value="true" />
                            <button type="submit" class="btn btn-tl">Take over</button>
                            <a class="btn btn-outline-secondary" asp-page="MyVehicle">Cancel</a>
                        </form>
                    </div>
                }

                @if (Model.Current is { } current)
                {
                    <p class="mb-1">You are driving</p>
                    <p class="h3">@current.Vehicle</p>
                    <p class="small text-body-secondary">Since @AppCulture.ToSast(current.Since).ToString("yyyy-MM-dd HH:mm")</p>
                }
                else
                {
                    <p>You have no vehicle yet.</p>
                }

                @if (Model.CanChoose)
                {
                    <form method="post" asp-page-handler="Link" class="d-flex flex-wrap gap-2 mb-2">
                        <select name="vehicleId" asp-items="Model.VehicleChoices" class="form-select w-auto flex-grow-1" aria-label="Vehicle">
                            <option value="">Choose a vehicle</option>
                        </select>
                        <button type="submit" class="btn btn-tl">Use this vehicle</button>
                    </form>
                    @if (Model.Current is not null)
                    {
                        <form method="post" asp-page-handler="Unlink">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">I am not driving it any more</button>
                        </form>
                    }
                }
                else
                {
                    <p class="small text-body-secondary mb-0">Your company links drivers to vehicles. If this is wrong, ask them to change it.</p>
                }
            </div>
        }
    </div>
</section>
