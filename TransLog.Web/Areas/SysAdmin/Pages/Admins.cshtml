@page
@model AdminsModel
@{
    ViewData["Title"] = "TransLog admins";
}

<section class="tl-section">
    <div class="container" style="max-width: 860px">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h1 class="tl-h2 mb-0">TransLog admins</h1>
            <a class="btn btn-tl" asp-page="/Users/Create">Add admin</a>
        </div>

        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }

        <p class="text-body-secondary">These people can see and change every company. Keep the list short.</p>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Name</th><th>Email</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var u in Model.Admins)
                    {
                        <tr>
                            <td><a asp-page="/Users/Edit" asp-route-id="@u.Id">@u.FullName</a></td>
                            <td>@u.Email</td>
                            <td>@(u.IsActive ? (u.LockedOut ? "Locked" : "Active") : "Off")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
