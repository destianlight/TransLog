@page
@model IndexModel
@{
    ViewData["Title"] = "Companies";
}

<section class="tl-section">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h1 class="tl-h2 mb-0">Companies</h1>
            <a class="btn btn-tl" asp-page="/Companies/Create">New company</a>
        </div>

        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }

        @if (Model.Companies.Count == 0)
        {
            <p class="text-body-secondary">No companies yet. Create the first one when a transporter contacts you.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr><th>Company</th><th>Users</th><th>Created</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Companies)
                        {
                            <tr>
                                <td><a asp-page="/Companies/Edit" asp-route-id="@c.Id">@c.Name</a></td>
                                <td>@c.Users</td>
                                <td>@AppCulture.ToSast(c.CreatedAt).ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (c.IsActive)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Off</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
