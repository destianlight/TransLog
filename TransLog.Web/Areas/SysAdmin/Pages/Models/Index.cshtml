@page
@model TransLog.Web.Areas.SysAdmin.Pages.Models.IndexModel
@using TransLog.Web.Fleet
@{
    ViewData["Title"] = "Vehicle models";
    var typeItems = VehicleOptions.Types;
    var fuelItems = VehicleOptions.FuelTypes;
}

<section class="tl-section">
    <div class="container" style="max-width: 860px">
        <h1 class="tl-h2 mb-2">Vehicle models</h1>
        <p class="text-body-secondary mb-4">
            One list for all companies. Companies pick a make and model for each vehicle, so fuel use and costs can be compared
            per model. Comparisons across companies show averages only, and only when at least 3 companies have that model.
        </p>

        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <div class="tl-card mb-4">
            <h2 class="h5">Typed by companies</h2>
            @if (Model.Typed.Count == 0)
            {
                <p class="small text-body-secondary mb-0">Nothing waiting. When a company picks Other and types a make and model, it shows here.</p>
            }
            else
            {
                <p class="small text-body-secondary">Add each one to the list (fix the spelling if needed). Its vehicles then move onto the list model.</p>
                @foreach (var t in Model.Typed)
                {
                    <form method="post" asp-page-handler="Adopt" class="border rounded p-3 mb-3">
                        <input type="hidden" name="otherMake" value="@t.Make" />
                        <input type="hidden" name="otherModel" value="@t.Model" />
                        <p class="mb-2"><strong>@t.Make @t.Model</strong> <span class="small text-body-secondary">· @t.Vehicles vehicle(s), @t.Companies company(ies)</span></p>
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <select name="makeId" class="form-select" aria-label="Make">
                                    <option value="">New make (type it)</option>
                                    @foreach (var m in Model.Makes)
                                    {
                                        if (string.Equals(m.Name, t.Make, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@m.Id" selected>@m.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@m.Id">@m.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-sm-6"><input name="newMake" class="form-control" value="@t.Make" placeholder="New make" aria-label="New make" /></div>
                            <div class="col-sm-4"><input name="modelName" class="form-control" value="@t.Model" placeholder="Model" aria-label="Model" required /></div>
                            <div class="col-sm-4">
                                <select name="type" class="form-select" aria-label="Type">
                                    <option value="">Type</option>
                                    @foreach (var x in typeItems) { <option>@x</option> }
                                </select>
                            </div>
                            <div class="col-sm-4">
                                <select name="fuel" class="form-select" aria-label="Fuel">
                                    <option value="">Fuel</option>
                                    @foreach (var x in fuelItems) { <option>@x</option> }
                                </select>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-tl btn-sm mt-2">Add to the list</button>
                    </form>
                }
            }
        </div>

        <div class="tl-card mb-4">
            <h2 class="h5">Add a make</h2>
            <form method="post" asp-page-handler="AddMake" class="d-flex gap-2">
                <input name="name" class="form-control" maxlength="50" placeholder="For example Volvo" aria-label="Make" required />
                <button type="submit" class="btn btn-tl">Add</button>
            </form>
        </div>

        <h2 class="h5 mb-3">Makes and models (@Model.Makes.Count makes)</h2>
        @foreach (var make in Model.Makes)
        {
            <details class="tl-card mb-2 py-3">
                <summary class="fw-semibold">@make.Name <span class="small text-body-secondary fw-normal">· @make.Models.Count(m => m.IsActive) model(s)</span></summary>
                <ul class="list-group my-3">
                    @foreach (var m in make.Models)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                            <span>
                                @m.Name
                                <span class="small text-body-secondary">@(string.Join(" · ", new[] { m.VehicleType, m.FuelType }.Where(x => x is not null)))</span>
                                @if (!m.IsActive)
                                {
                                    <span class="badge text-bg-secondary">Hidden</span>
                                }
                            </span>
                            <form method="post" asp-page-handler="ToggleModel" asp-route-modelId="@m.Id">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">@(m.IsActive ? "Hide" : "Show")</button>
                            </form>
                        </li>
                    }
                </ul>
                <form method="post" asp-page-handler="AddModel" asp-route-makeId="@make.Id" class="row g-2">
                    <div class="col-sm-4"><input name="name" class="form-control" maxlength="50" placeholder="New model" aria-label="New model" required /></div>
                    <div class="col-sm-3">
                        <select name="type" class="form-select" aria-label="Type">
                            <option value="">Type</option>
                            @foreach (var x in typeItems) { <option>@x</option> }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <select name="fuel" class="form-select" aria-label="Fuel">
                            <option value="">Fuel</option>
                            @foreach (var x in fuelItems) { <option>@x</option> }
                        </select>
                    </div>
                    <div class="col-sm-2"><button type="submit" class="btn btn-tl w-100">Add</button></div>
                </form>
            </details>
        }
    </div>
</section>
