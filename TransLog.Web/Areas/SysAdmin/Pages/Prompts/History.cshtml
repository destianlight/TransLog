@page "{id:int}"
@model TransLog.Web.Areas.SysAdmin.Pages.Prompts.HistoryModel
@using TransLog.Web.Ai
@{
    ViewData["Title"] = "History: " + Model.Entry.Name;
}

<section class="tl-section">
    <div class="container" style="max-width: 980px">
        <p class="mb-2"><a asp-page="Edit" asp-route-id="@Model.Entry.Id">&larr; @Model.Entry.Name</a></p>
        <h1 class="tl-h2 mb-1">History</h1>
        <p class="text-body-secondary"><code>@Model.Entry.Key</code> · @Model.Entry.Name · now @PromptSet.VersionLabel(Model.Entry.CurrentVersion)</p>

        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        @if (Model.Errors.Count > 0)
        {
            <div class="alert alert-danger small">
                <div class="fw-semibold">Not restored:</div>
                <ul class="mb-0">
                    @foreach (var e in Model.Errors)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }

        @foreach (var row in Model.Versions)
        {
            var v = row.Version;
            var current = v.Version == Model.Entry.CurrentVersion;
            <details class="tl-card mb-2" data-version="@v.Version">
                <summary>
                    <strong>@PromptSet.VersionLabel(v.Version)</strong>
                    · @AppCulture.ToSast(v.CreatedAt).ToString("yyyy-MM-dd HH:mm") · @row.By
                    @if (current)
                    {
                        <span class="badge text-bg-success ms-1">Current</span>
                    }
                </summary>
                <dl class="row small mt-3 mb-2">
                    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@v.Name</dd>
                    <dt class="col-sm-3">Scope</dt><dd class="col-sm-9">@row.Companies</dd>
                    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(v.IsActive ? "On" : "Off")</dd>
                    <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@(v.Description ?? "–")</dd>
                    @if (row.Fields.Count > 0)
                    {
                        <dt class="col-sm-3">Fields</dt>
                        <dd class="col-sm-9">
                            @foreach (var f in row.Fields)
                            {
                                <div><code>@f.Key</code> @(f.Label + " · " + PromptRules.FieldTypeNames.GetValueOrDefault(f.Type, f.Type) + (f.Unit is null ? "" : " (" + f.Unit + ")") + (f.Required ? " · required" : "") + (f.Core is null ? "" : " · core " + f.Core))</div>
                            }
                        </dd>
                    }
                </dl>
                <pre class="small border rounded-3 p-2" style="white-space: pre-wrap">@v.Prompt</pre>
                @if (!current)
                {
                    <form method="post" asp-page-handler="Restore" asp-route-id="@Model.Entry.Id" class="mt-2">
                        <input type="hidden" name="version" value="@v.Version" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@Icons.Svg("arrow-counterclockwise") Restore this version</button>
                    </form>
                }
            </details>
        }
    </div>
</section>
