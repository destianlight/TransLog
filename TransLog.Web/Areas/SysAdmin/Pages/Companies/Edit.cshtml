@page "{id:int}"
@model TransLog.Web.Areas.SysAdmin.Pages.Companies.EditModel
@{
    ViewData["Title"] = Model.Name;
}

<section class="tl-section">
    <div class="container" style="max-width: 860px">
        <p class="mb-2"><a asp-page="/Index">&larr; Companies</a></p>
        <h1 class="tl-h2 mb-4">@Model.Name</h1>

        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }

        <partial name="_LoginDetails" />

        <form method="post" class="tl-card mb-5">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>
            <partial name="_CompanyFields" for="Form" />
            <div class="form-check form-switch mb-4">
                <input asp-for="IsActive" class="form-check-input" role="switch" />
                <label asp-for="IsActive" class="form-check-label">Company is active (switch off to block all its users)</label>
            </div>
            <button type="submit" class="btn btn-tl">Save</button>
        </form>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <h2 class="h4 mb-0">Users</h2>
            <a class="btn btn-outline-secondary" asp-page="/Users/Create" asp-route-companyId="@Model.Id">Add user</a>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr><th>Name</th><th>Email and cell</th><th>Role</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        <tr>
                            <td><a asp-page="/Users/Edit" asp-route-id="@u.Id">@u.FullName</a></td>
                            <td>@u.Email<div class="small text-body-secondary">@u.Cell</div></td>
                            <td>@u.Role</td>
                            <td>
                                @if (!u.IsActive)
                                {
                                    <span class="badge text-bg-secondary">Off</span>
                                }
                                else if (u.LockedOut)
                                {
                                    <span class="badge text-bg-warning">Locked</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
